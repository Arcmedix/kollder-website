  <div class="partner-section__inner partner-apply">

    <div class="partner-apply__left">
      <h2>Angebot für Ihre Veranstaltung anfordern</h2>
      <p>Beschreiben Sie Ihren Bedarf. Wir melden uns innerhalb von 48 Stunden mit einem passenden Angebot für Ihre Veranstaltung.</p>

      <div class="partner-apply__criteria">
        <p class="partner-apply__criteria-title">Die Kollder Notfall-Kühlwanne im Überblick:</p>
        <ul class="partner-criteria">
          <li>Stabile Struktur, Platz für bis zu 2 Personen bei gleichzeitiger Immersion</li>
          <li>Zusammengelegt: 85 × 10 × 10 cm, 11,1 kg, ohne eigenes Fahrzeug transportierbar</li>
          <li>Struktur aus lebensmittelechtem Edelstahl</li>
          <li>Ganzkörperimmersion, 360-Grad-Zugang zum Patienten</li>
        </ul>
      </div>
    </div>

    <div class="partner-apply__right">
      <form action="https://formspree.io/f/mykovqeg" method="POST" class="partner-form" onsubmit="if(typeof gtag==='function'){gtag('event','quote_request_submit',{form_location:'sportveranstaltungen-medizin',transport_type:'beacon'});}">
        <div class="partner-form__field">
          <label for="name">Vor- und Nachname</label>
          <input type="text" id="name" name="name" placeholder="z. B. Max Mustermann" required>
        </div>
        <div class="partner-form__field">
          <label for="email">E-Mail</label>
          <input type="email" id="email" name="email" placeholder="z. B. name@veranstaltung.de" required>
        </div>
        <div class="partner-form__field">
          <label for="phone">Telefon</label>
          <input type="tel" id="phone" name="phone" placeholder="z. B. 0170 0000000" required>
        </div>
        <div class="partner-form__field">
          <label for="organisation">Organisation</label>
          <input type="text" id="organisation" name="organisation" placeholder="z. B. Medizinischer Posten Veranstaltung" required>
        </div>
        <div class="partner-form__field">
          <label for="volume">Gewünschte Stückzahl</label>
          <select id="volume" name="volume" required>
            <option value="">Bitte wählen</option>
            <option value="1-4">1 bis 4 Einheiten</option>
            <option value="5-9">5 bis 9 Einheiten</option>
            <option value="10-19">10 bis 19 Einheiten</option>
            <option value="20-49">20 bis 49 Einheiten</option>
            <option value="50+">50 Einheiten und mehr</option>
          </select>
        </div>
        <input type="hidden" name="_subject" value="Neue Kollder Anfrage: Sportveranstaltungen">
        <button type="submit" class="partner-btn">Angebot anfordern</button>
        <p class="partner-note" style="margin-top:0;border-top:none;padding-top:0;">Antwort innerhalb von 48h. Vertrauliche Daten.</p>
      </form>
    </div>

  </div>
</section>

<script>
(function() {
  var current = 0;
  var track = document.getElementById('heroCarouselTrack');
  if (!track) return;
  var dots = document.querySelectorAll('#heroCarousel .carousel-dot');
  var thumbs = document.querySelectorAll('.thumb-strip .thumb');
  var timer;
  function goTo(n) {
    current = (n + 4) % 4;
    track.style.transform = 'translateX(-' + (current * 25) + '%)';
    dots.forEach(function(d,i){ d.classList.toggle('active', i===current); });
    thumbs.forEach(function(t,i){ t.classList.toggle('active', i===current); });
    clearInterval(timer);
    timer = setInterval(function(){ goTo(current+1); }, 4000);
  }
  window.heroGoTo = goTo;
  timer = setInterval(function(){ goTo(current+1); }, 4000);
})();

(function() {
  var track = document.getElementById('sportFieldTrack');
  var wrap = document.getElementById('sportFieldTrackWrap');
  var dots = document.querySelectorAll('#sportFieldDots .field-dot');
  if (!track) return;

  var current = 0;
  var total = track.children.length;

  function getSlideWidth() {
    var slide = track.children[0];
    if (!slide) return 540;
    var style = window.getComputedStyle(track);
    var gap = parseInt(style.gap || style.columnGap || '20') || 20;
    return slide.offsetWidth + gap;
  }

  window.sportFieldGoTo = function(n) {
    current = Math.max(0, Math.min(n, total - 1));
    track.style.transform = 'translateX(-' + (current * getSlideWidth()) + 'px)';
    dots.forEach(function(d, i) {
      d.classList.toggle('active', i === current);
    });
  };

  window.sportFieldStep = function(dir) {
    var next = current + dir;
    if (next < 0) next = total - 1;
    if (next >= total) next = 0;
    window.sportFieldGoTo(next);
  };

  var startX = 0, dragging = false;
  wrap.addEventListener('mousedown', function(e) {
    dragging = true; startX = e.pageX;
    wrap.style.cursor = 'grabbing';
  });
  document.addEventListener('mouseup', function(e) {
    if (!dragging) return;
    dragging = false;
    wrap.style.cursor = 'grab';
    var diff = startX - e.pageX;
    if (Math.abs(diff) > 60) window.sportFieldStep(diff > 0 ? 1 : -1);
    else window.sportFieldGoTo(current);
  });
  wrap.addEventListener('touchstart', function(e) {
    startX = e.touches[0].pageX;
  }, { passive: true });
  wrap.addEventListener('touchend', function(e) {
    var diff = startX - e.changedTouches[0].pageX;
    if (Math.abs(diff) > 50) window.sportFieldStep(diff > 0 ? 1 : -1);
  }, { passive: true });

  var timer = setInterval(function() { window.sportFieldStep(1); }, 5000);
  wrap.addEventListener('mouseenter', function() { clearInterval(timer); });
  wrap.addEventListener('mouseleave', function() {
    clearInterval(timer);
    timer = setInterval(function() { window.sportFieldStep(1); }, 5000);
  });
})();
</script>
