{% set articleAuthor = "Julie M." %}
<!DOCTYPE html>
<html lang="{% if lang == 'en' %}en{% else %}fr{% endif %}">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-SF9XF8JQZK"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-SF9XF8JQZK');
</script>
<!-- Microsoft clarity tag -->
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wy0jm2kj2r");
</script>
<meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — Kollder</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://kollder.com{{ page.url }}">
<meta property="og:title" content="{{ title }} — Kollder">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="https://kollder.com{{ page.url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "datePublished": "{{ date | dateFormat }}",
  "author": { "@type": "Person", "name": "{{ articleAuthor }}" },
  "publisher": { "@type": "Organization", "name": "Kollder", "url": "https://kollder.com" }
}
</script>
{% if faqSchema %}
<script type="application/ld+json">
{{ faqSchema | safe }}
</script>
{% endif %}
{% if howToSchema %}
<script type="application/ld+json">
{{ howToSchema | safe }}
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --black: #0f0f0d; --ink: #1a1a17; --white: #faf9f7;
  --cream: #f0ece4; --beige: #e8e0d4; --sand: #c8bfb0;
  --muted: #8a8278; --border: rgba(26,26,23,0.1);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--white); color: var(--ink); font-family: 'DM Sans', sans-serif; font-weight: 300; line-height: 1.7; }

nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 56px; background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0,0,0,0.08);
}
.nav-brand img { height: 52px; width: auto; display: block; }
.nav-right { display: flex; align-items: center; gap: 28px; }
.nav-link {
  font-size: 13px; font-weight: 500; color: var(--muted);
  text-decoration: none; letter-spacing: 0.06em;
  display: flex; align-items: center; gap: 8px; transition: color .2s;
}
.nav-link:hover { color: var(--ink); }
.nav-link-active { color: var(--ink); }
.nav-devis {
  font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;
  padding: 9px 20px; background: var(--black); color: var(--white);
  transition: background .2s;
}
.nav-devis:hover { background: #333; }
.nav-badge {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--sand); color: var(--ink); font-size: 10px; font-weight: 500;
  padding: 1px 6px; border-radius: 10px; margin-left: 4px;
}
.nav-dropdown { position: relative; display: inline-flex; align-items: center; }
.nav-dropdown-arrow { margin-left: 5px; transition: transform .2s; }
.nav-dropdown:hover .nav-dropdown-arrow, .nav-dropdown:focus-within .nav-dropdown-arrow { transform: rotate(180deg); }
.nav-dropdown-menu {
  position: absolute; top: 100%; left: 0; margin-top: 14px;
  background: var(--white); border: 1px solid var(--border);
  box-shadow: 0 12px 32px rgba(0,0,0,0.1); min-width: 230px; padding: 8px;
  opacity: 0; visibility: hidden; transform: translateY(6px);
  transition: opacity .2s ease, transform .2s ease, visibility .2s;
}
.nav-dropdown:hover .nav-dropdown-menu, .nav-dropdown:focus-within .nav-dropdown-menu {
  opacity: 1; visibility: visible; transform: translateY(0);
}
.nav-dropdown-item {
  display: block; padding: 10px 14px; font-size: 13px; font-weight: 500;
  color: var(--ink); text-decoration: none; letter-spacing: 0.02em;
  transition: background .15s;
}
.nav-dropdown-item:hover { background: var(--cream); }
.nav-overlay-close {
  position: absolute; top: 24px; right: 24px; z-index: 5;
  display: flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; background: none; border: none; cursor: pointer;
  color: var(--ink, #1a1a17);
}
.nav-overlay-close svg { display: block; }
.nav-overlay-toggle {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; background: none; border: none; text-align: left; cursor: pointer;
  font-size: 22px; font-weight: 400; color: var(--ink);
  padding: 14px 0; border-bottom: 1px solid var(--border);
  font-family: 'DM Serif Display', serif;
}
.nav-overlay-toggle-arrow { transition: transform .25s ease; flex-shrink: 0; width: 14px; height: 14px; }
.nav-overlay-toggle[aria-expanded="true"] .nav-overlay-toggle-arrow { transform: rotate(180deg); }
.nav-overlay-sublinks { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
.nav-overlay-sublinks.open { max-height: 480px; }
.nav-overlay-sublink {
  font-size: 16px; font-weight: 400; color: var(--ink); text-decoration: none;
  padding: 10px 0 10px 4px; display: flex; align-items: center; justify-content: space-between;
  font-family: 'DM Sans', sans-serif; border-bottom: 1px solid var(--border);
}
.nav-overlay-sublink:last-of-type { border-bottom: none; }
.lang-switcher-trigger { padding: 0; }
.lang-switcher-trigger svg:first-child { display: block; }
.lang-switcher-menu { min-width: 160px; }
.lang-switcher-menu .nav-dropdown-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.lang-switcher-menu .nav-dropdown-item.active { color: var(--black); font-weight: 600; }
.lang-switcher-menu .nav-dropdown-item.active::after { content: '✓'; font-size: 11px; color: var(--sand); }
.nav-overlay-sublink.active { color: var(--black); font-weight: 500; }
.nav-overlay-sublink.active span::after { content: '✓'; margin-left: 8px; font-size: 13px; color: var(--sand); }

/* Hamburger */
.ham-btn {
  display: none; flex-direction: column; justify-content: center;
  gap: 5px; background: none; border: none; cursor: pointer;
  padding: 4px; z-index: 200;
}
.ham-btn span {
  display: block; width: 22px; height: 2px;
  background: var(--ink); transition: all .25s;
}
.ham-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.ham-btn.open span:nth-child(2) { opacity: 0; }
.ham-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Mobile overlay */
.nav-overlay {
  display: none; position: fixed; inset: 0; z-index: 150;
  background: var(--white); flex-direction: column;
  padding: 90px 32px 40px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.nav-overlay.open { display: flex; }
.nav-overlay-links {
  display: flex; flex-direction: column; gap: 8px; flex: 1;
}
.nav-overlay-link {
  font-size: 22px; font-weight: 400; color: var(--ink);
  text-decoration: none; padding: 14px 0;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  font-family: 'DM Serif Display', serif;
}
.nav-overlay-link:last-child { border-bottom: none; }
.nav-overlay-badge {
  display: inline-block; font-size: 10px; font-weight: 500;
  letter-spacing: 0.04em; font-family: 'DM Sans', sans-serif;
  background: var(--beige, #e8e4dc); color: var(--muted, #888);
  padding: 2px 8px; border-radius: 20px; margin-left: 8px;
  vertical-align: middle; line-height: 1.6;
}
.nav-overlay-cta {
  display: inline-flex; align-items: center; gap: 10px; margin-top: 32px;
  background: var(--black); color: var(--white); text-decoration: none;
  font-size: 13px; font-weight: 500; letter-spacing: 0.1em;
  text-transform: uppercase; padding: 16px 28px; align-self: flex-start;
}
.article-hero {
  padding: 140px 56px 60px; background: var(--black); color: var(--white);
}
.article-hero-inner { max-width: 800px; margin: 0 auto; }
.article-cat {
  font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 20px;
}
.article-hero h1 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(32px, 4vw, 52px); font-weight: 400;
  line-height: 1.1; color: var(--white); margin-bottom: 20px;
}
.article-date { font-size: 13px; color: rgba(250,249,247,0.4); letter-spacing: 0.06em; }
.article-byline { font-size: 13px; color: rgba(250,249,247,0.6); letter-spacing: 0.06em; margin-bottom: 6px; }

.article-body { max-width: 800px; margin: 0 auto; padding: 64px 56px 100px; }

.article-body h1 { font-family: 'DM Serif Display', serif; font-size: 36px; font-weight: 400; margin: 48px 0 20px; color: var(--black); line-height: 1.15; }
.article-body h2 { font-family: 'DM Serif Display', serif; font-size: 28px; font-weight: 400; margin: 44px 0 16px; color: var(--black); line-height: 1.2; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
.article-body h3 { font-family: 'DM Sans', sans-serif; font-size: 17px; font-weight: 500; margin: 32px 0 12px; color: var(--black); }
.article-body p { font-size: 16px; color: var(--ink); line-height: 1.8; margin-bottom: 20px; }
.article-body strong { font-weight: 500; color: var(--black); }
.article-body em { font-style: italic; color: var(--muted); }
.article-body ul, .article-body ol { padding-left: 24px; margin-bottom: 20px; }
.article-body li { font-size: 16px; color: var(--ink); line-height: 1.75; margin-bottom: 8px; }
.article-body blockquote { border-left: 3px solid var(--sand); padding-left: 20px; margin: 28px 0; font-style: italic; color: var(--muted); }
.article-body a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
.article-body a:hover { color: var(--black); }
.article-body hr { border: none; border-top: 1px solid var(--border); margin: 40px 0; }
.article-body table { width: 100%; border-collapse: collapse; margin: 28px 0; font-size: 14px; }
.article-body th { background: var(--ink); color: var(--white); padding: 12px 16px; text-align: left; font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
.article-body td { padding: 12px 16px; border-bottom: 1px solid var(--border); color: var(--ink); vertical-align: top; }
.article-body tr:nth-child(even) td { background: var(--cream); }

.article-cta {
  background: var(--cream); border: 1px solid var(--border);
  padding: 32px 36px; margin: 48px 0;
}
.article-cta p { margin: 0 0 16px; }
.article-cta a {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--black); color: var(--white) !important;
  font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase;
  padding: 13px 24px; text-decoration: none !important;
  transition: background .2s;
}
.article-cta a:hover { background: #333; }

.article-mid-cta {
  background: var(--black); padding: 28px 32px; margin: 40px 0;
  display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
}
.article-mid-cta p { font-size: 15px; color: rgba(250,249,247,0.8); margin: 0; line-height: 1.5; flex: 1; }
.article-mid-cta strong { color: var(--white); font-weight: 500; }
.article-mid-cta a {
  display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0;
  background: var(--white); color: var(--black) !important;
  font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 12px 22px; text-decoration: none !important; transition: background .2s;
}
.article-mid-cta a:hover { background: var(--cream); }

footer {
  background: #000; border-top: 1px solid rgba(255,255,255,0.08); padding: 40px 56px;
}
.footer-inner {
  max-width: 1240px; margin: 0 auto;
  display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap;
}
.footer-brand img { height: 52px; width: auto; display: block; filter: invert(1); }
.footer-note { font-size: 12px; color: rgba(250,249,247,0.25); letter-spacing: 0.04em; }

@media (max-width: 768px) {
  nav { padding: 14px 24px; }
  .nav-right { display: none; }
  .ham-btn { display: flex; }
  .article-hero { padding: 110px 24px 48px; }
  .article-body { padding: 48px 24px 72px; }
  footer { padding: 32px 24px; }
  .article-body table { display: block; overflow-x: auto; }
  .article-mid-cta { flex-direction: column; }
}
</style>
</head>
<body>

{% set langLinks = [{code: "fr", url: "/blog/?lang=fr"}, {code: "en", url: "/blog/?lang=en"}, {code: "de", url: "/de/"}, {code: "es", url: "/es/"}] %}
<nav>
  <div class="nav-brand">
    <a href="/"><img src="/logo-kollder.png" alt="Kollder"></a>
  </div>
  <div class="nav-right">
    <a href="{{ nav[lang].homeUrl }}" class="nav-link">{{ nav[lang].home }}</a>
    <a href="{{ nav[lang].partnersUrl }}" class="nav-link">{{ nav[lang].partners }}</a>
    <div class="nav-dropdown">
      <a href="javascript:void(0)" class="nav-link">{{ nav[lang].whoWeServe }}<svg class="nav-dropdown-arrow" width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6l4 4 4-4"/></svg></a>
      <div class="nav-dropdown-menu">
        {% for sector in nav[lang].sectors %}
        <a class="nav-dropdown-item" href="{{ sector.url }}">{{ sector.label }}</a>
        {% endfor %}
      </div>
    </div>
    <a href="{{ nav[lang].resourcesUrl }}" class="nav-link nav-link-active">
      {{ nav[lang].resources }}<span class="nav-badge" id="nav-badge"></span>
    </a>
    <a href="{{ nav[lang].monitorUrl }}" class="nav-link" style="display:inline-flex;align-items:center;gap:5px;opacity:.85;"><span style="width:7px;height:7px;border-radius:50%;background:#e85c3a;display:inline-block;animation:pulse-dot 2s ease-in-out infinite;"></span>{{ nav[lang].monitor }}</a>
    <a href="{{ nav[lang].quoteUrl }}" class="nav-devis">
      {{ nav[lang].quote }}
    </a>
    <div class="nav-dropdown lang-switcher">
      <a href="javascript:void(0)" class="nav-link lang-switcher-trigger" aria-label="{{ nav[lang].langAria }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><line x1="3" y1="12" x2="21" y2="12"></line><path d="M12 3c2.8 2.6 4.3 5.8 4.3 9s-1.5 6.4-4.3 9c-2.8-2.6-4.3-5.8-4.3-9s1.5-6.4 4.3-9z"></path></svg><svg class="nav-dropdown-arrow" width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6l4 4 4-4"/></svg></a>
      <div class="nav-dropdown-menu lang-switcher-menu">
        {% for l in langLinks %}<a class="nav-dropdown-item{% if lang == l.code %} active{% endif %}" href="{{ l.url }}">{{ nav.langNames[l.code] }}</a>{% endfor %}
      </div>
    </div>
  </div>
  <button class="ham-btn" id="hamBtn" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- Mobile overlay -->
<div class="nav-overlay" id="navOverlay">
  <button type="button" class="nav-overlay-close" aria-label="{{ nav[lang].closeMenu }}" onclick="closeNavOverlay()">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l10 10M15 5L5 15"/></svg>
  </button>
  <div class="nav-overlay-links">
    <a class="nav-overlay-link" href="{{ nav[lang].homeUrl }}">
      <span>{{ nav[lang].home }}</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    <a class="nav-overlay-link" href="{{ nav[lang].partnersUrl }}">
      <span>{{ nav[lang].partners }}</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    <button type="button" class="nav-overlay-toggle" aria-expanded="false" onclick="toggleNavOverlayGroup(this)">
      <span>{{ nav[lang].whoWeServe }}</span>
      <svg class="nav-overlay-toggle-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6l4 4 4-4"/></svg>
    </button>
    <div class="nav-overlay-sublinks">
    {% for sector in nav[lang].sectors %}
    <a class="nav-overlay-sublink" href="{{ sector.url }}"><span>{{ sector.label }}</span></a>
    {% endfor %}
    </div>
    <a class="nav-overlay-link" href="{{ nav[lang].resourcesUrl }}">
      <span>{{ nav[lang].resources }}</span><span class="nav-overlay-badge" id="ov-badge"></span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    <a class="nav-overlay-link" href="{{ nav[lang].monitorUrl }}">
      <span>{{ nav[lang].monitor }} <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#e85c3a;margin-left:4px;vertical-align:middle;"></span></span><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    <button type="button" class="nav-overlay-toggle" aria-expanded="false" onclick="toggleNavOverlayGroup(this)">
      <span style="display:inline-flex;align-items:center;gap:10px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><line x1="3" y1="12" x2="21" y2="12"></line><path d="M12 3c2.8 2.6 4.3 5.8 4.3 9s-1.5 6.4-4.3 9c-2.8-2.6-4.3-5.8-4.3-9s1.5-6.4 4.3-9z"></path></svg>{{ nav[lang].language }}</span>
      <svg class="nav-overlay-toggle-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6l4 4 4-4"/></svg>
    </button>
    <div class="nav-overlay-sublinks">
    {% for l in langLinks %}<a class="nav-overlay-sublink{% if lang == l.code %} active{% endif %}" href="{{ l.url }}"><span>{{ nav.langNames[l.code] }}</span></a>{% endfor %}
    </div>
  </div>
  <a class="nav-overlay-cta" href="{{ nav[lang].quoteUrl }}">
    <span>{{ nav[lang].quote }}</span>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
  </a>
</div>

<section class="article-hero">
  <div class="article-hero-inner">
    <p class="article-cat">{{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="article-byline">{% if lang == 'en' %}By {{ articleAuthor }}{% else %}Par {{ articleAuthor }}{% endif %}</p>
    <p class="article-date">{{ date | dateFormat }}</p>
  </div>
</section>

<article class="article-body">
  {{ content | safe }}

  <div class="article-cta">
    {% if category == "Vie d'église" or category == "Church Life" %}
    <p><strong>{% if lang == 'en' %}Kollder is the portable baptistry that sets up in under 2 minutes, anywhere.{% else %}Kollder est le baptistère portable qui s'installe en moins de 2 minutes, partout.{% endif %}</strong></p>
    <a href="{% if lang == 'en' %}/en/portable-baptistry/#devis{% else %}/fr/baptistere-immersion/#devis{% endif %}">
      {% if lang == 'en' %}Request a quote{% else %}Obtenir un devis{% endif %}
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    {% else %}
    <p><strong>{% if lang == 'en' %}Kollder is the emergency cooling tub built for stability, folds flat for transport, and fits 2 people at once.{% else %}Kollder est la baignoire de refroidissement d'urgence stable, entièrement pliable, conçue pour accueillir 2 personnes à la fois.{% endif %}</strong></p>
    <a href="/#contact">
      {% if lang == 'en' %}Request a quote{% else %}Obtenir un devis{% endif %}
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
    {% endif %}
  </div>
</article>

<footer>
  <div class="footer-inner">
    <div class="footer-brand"><img src="/logo-kollder.png" alt="Kollder"></div>
    <div class="footer-note">Emergency Cooling. Anywhere.</div>
  </div>
</footer>

<script src="/lang.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Article count badge
  fetch('/article-count.json')
    .then(r => r.json())
    .then(d => {
      var nb = document.getElementById('nav-badge');
      var ob = document.getElementById('ov-badge');
      if (nb && d.count) nb.textContent = d.count;
      if (ob && d.count) ob.textContent = d.count;
    })
    .catch(() => {});

  // Hamburger toggle
  var btn = document.getElementById('hamBtn');
  var overlay = document.getElementById('navOverlay');
  btn.addEventListener('click', function() {
    var isOpen = overlay.classList.toggle('open');
    btn.classList.toggle('open', isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  // Close overlay on link click
  overlay.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() {
      overlay.classList.remove('open');
      btn.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
});

window.toggleNavOverlayGroup = function(btn) {
  var panel = btn.nextElementSibling;
  var isOpen = panel.classList.toggle('open');
  btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
};
window.closeNavOverlay = function() {
  var overlay = document.getElementById('navOverlay');
  var btn = document.getElementById('hamBtn');
  if (overlay) overlay.classList.remove('open');
  if (btn) btn.classList.remove('open');
  document.body.style.overflow = '';
};

</script>

</body>
</html>
