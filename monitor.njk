function calcWBGT(t,h){var tw=t*Math.atan(0.151977*Math.sqrt(h+8.313659))+Math.atan(t+h)-Math.atan(h-1.676331)+0.00391838*Math.pow(h,1.5)*Math.atan(0.023101*h)-4.686035;return Math.round((0.7*tw+0.3*t)*10)/10;}
function getRisk(w){if(w>=35)return 3;if(w>=31)return 2;if(w>=28)return 1;return 0;}
function pickRisk(){return LANG==='de'?RISK_DE:(LANG==='es'?RISK_ES:(LANG==='en'?RISK_EN:RISK_FR));}
function pickRecos(){return LANG==='de'?RECOS_DE:(LANG==='es'?RECOS_ES:(LANG==='en'?RECOS_EN:RECOS_FR));}
function pickDays(){return LANG==='de'?DAYS_DE:(LANG==='es'?DAYS_ES:(LANG==='en'?DAYS_EN:DAYS_FR));}
function pickAlert(){return LANG==='de'?ALERT_DE:(LANG==='es'?ALERT_ES:(LANG==='en'?ALERT_EN:ALERT_FR));}
function localeTag(){return LANG==='de'?'de-DE':(LANG==='es'?'es-ES':(LANG==='en'?'en-GB':'fr-FR'));}
function todayLabel(){return LANG==='de'?'Heute':(LANG==='es'?'Hoy':(LANG==='en'?'Today':'Auj.'));}
function loadingErrorLabel(){return LANG==='de'?"Fehler beim Laden. Bitte Verbindung prüfen.":(LANG==='es'?"Error de carga. Compruebe la conexión.":(LANG==='en'?"Loading error. Please check your connection.":"Erreur de chargement. Vérifiez la connexion."));}

