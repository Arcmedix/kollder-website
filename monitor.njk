(async function autoDetect(){
  try{
    var geo=await fetch('https://ipapi.co/json/');
    var gd=await geo.json();
    var code=DEFAULT_CODE;
    if(LANG==='fr' || LANG==='en'){
      if(gd.country_code==='FR' && gd.region_code){
        // ipapi.co returns region_code as dept number string for France ("01".."95","2A","2B","971"..)
        var rc=String(gd.region_code);
        var found=REGIONS.find(function(x){return x.c===rc;});
        if(found) code=found.c;
        else code=REGIONS[Math.floor(Math.random()*REGIONS.length)].c;
      } else {
        code=REGIONS[Math.floor(Math.random()*REGIONS.length)].c;
      }
    } else if((LANG==='de' && gd.country_code==='DE') || (LANG==='es' && gd.country_code==='ES')){
      // Nearest region centroid by simple squared distance from the visitor's coordinates
      if(typeof gd.latitude==='number' && typeof gd.longitude==='number'){
        var best=null, bestDist=Infinity;
        REGIONS.forEach(function(rgn){
          var dd=Math.pow(rgn.lat-gd.latitude,2)+Math.pow(rgn.lon-gd.longitude,2);
          if(dd<bestDist){bestDist=dd;best=rgn;}
        });
        if(best) code=best.c;
      }
    }
    sel.value=code;
    loadDept(code);
  }catch(e){
    sel.value=DEFAULT_CODE;
    loadDept(DEFAULT_CODE);
  }
})();
</script>
