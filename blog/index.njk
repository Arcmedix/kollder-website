      <a href="/blog/" class="cat-pill all" id="pill-all-en">All</a>
      {% for cat in collections.categories %}
      <a href="/blog/en/category/{{ cat.slug_en }}/" class="cat-pill">{{ cat.label_en }}</a>
      {% endfor %}
    </div>

    <div id="cat-tabs-de" style="display:none;">
      <button type="button" class="cat-pill active" id="pill-all-de" data-lang="de" data-filter="">Alle</button>
      {% for cat in collections.blog_de_public | uniqueCategories %}
      <button type="button" class="cat-pill" data-lang="de" data-filter="{{ cat }}">{{ cat }}</button>
      {% endfor %}
    </div>

    <div id="cat-tabs-es" style="display:none;">
      <button type="button" class="cat-pill active" id="pill-all-es" data-lang="es" data-filter="">Todos</button>
      {% for cat in collections.blog_es_public | uniqueCategories %}
      <button type="button" class="cat-pill" data-lang="es" data-filter="{{ cat }}">{{ cat }}</button>
      {% endfor %}
    </div>

  </div>
</div>

<div class="blog-section">
  <div class="articles-grid" id="articlesGrid">

    <div id="fr-articles" style="display:contents;">
      {% set frPosts = collections.blog_fr_public %}
      {% if frPosts.length %}
        {% for post in frPosts %}
        <a href="{{ post.url }}" class="article-card">
          <div class="article-body-inner">
            <p class="article-cat">{{ post.data.category }}</p>
            <h2 class="article-title">{{ post.data.title }}</h2>
            <p class="article-desc">{{ post.data.description }}</p>
            <p class="article-date">{{ post.date | dateFormat }}</p>
            <span class="article-read">
              Lire l'article
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </span>
          </div>
        </a>
        {% endfor %}
      {% else %}
        <div class="empty-state"><strong>Les articles arrivent bientôt.</strong><span>Revenez prochainement.</span></div>
      {% endif %}
    </div>

    <div id="en-articles" style="display:none;">
      {% set enPosts = collections.blog_en_public %}
      {% if enPosts.length %}
        {% for post in enPosts %}
        <a href="{{ post.url }}" class="article-card">
          <div class="article-body-inner">
            <p class="article-cat">{{ post.data.category }}</p>
            <h2 class="article-title">{{ post.data.title }}</h2>
            <p class="article-desc">{{ post.data.description }}</p>
            <p class="article-date">{{ post.date | dateFormatEN }}</p>
            <span class="article-read">
              Read article
              <svg width="12" height="12" viewBox="0 0 16 16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </span>
          </div>
        </a>
        {% endfor %}
      {% else %}
        <div class="empty-state"><strong>Articles coming soon.</strong><span>Check back soon.</span></div>
      {% endif %}
    </div>

    <div id="de-articles" style="display:none;">
      {% set dePosts = collections.blog_de_public %}
      {% if dePosts.length %}
        {% for post in dePosts %}
        <a href="{{ post.url }}" class="article-card" data-cat="{{ post.data.category }}">
          <div class="article-body-inner">
            <p class="article-cat">{{ post.data.category }}</p>
            <h2 class="article-title">{{ post.data.title }}</h2>
            <p class="article-desc">{{ post.data.description }}</p>
            <p class="article-date">{{ post.date | dateFormatDE }}</p>
            <span class="article-read">
              Artikel lesen
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </span>
          </div>
        </a>
        {% endfor %}
      {% else %}
        <div class="empty-state"><strong>Artikel folgen in Kürze.</strong><span>Schauen Sie bald wieder vorbei.</span></div>
      {% endif %}
    </div>

    <div id="es-articles" style="display:none;">
      {% set esPosts = collections.blog_es_public %}
      {% if esPosts.length %}
        {% for post in esPosts %}
        <a href="{{ post.url }}" class="article-card" data-cat="{{ post.data.category }}">
          <div class="article-body-inner">
            <p class="article-cat">{{ post.data.category }}</p>
            <h2 class="article-title">{{ post.data.title }}</h2>
            <p class="article-desc">{{ post.data.description }}</p>
            <p class="article-date">{{ post.date | dateFormatES }}</p>
            <span class="article-read">
              Leer el artículo
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </span>
          </div>
        </a>
        {% endfor %}
      {% else %}
        <div class="empty-state"><strong>Artículos próximamente.</strong><span>Vuelve pronto.</span></div>
      {% endif %}
    </div>

  </div>
</div>

<footer>
  <div class="footer-inner">
    <div class="footer-brand"><img src="/logo-kollder.png" alt="Kollder"></div>
    <div class="footer-note">Emergency Cooling. Anywhere.</div>
  </div>
</footer>

<script>
const LANGS = ['fr', 'en', 'de', 'es'];
const T = {
  fr: {
    home: 'Accueil', homeUrl: '/?lang=fr',
    distrib: 'Distributeurs', distribUrl: '/fr/distributeurs/',
    secteurs: 'Secteurs',
    sdis: 'SDIS / Pompiers', sdisUrl: '/fr/sdis-pompiers/',
    samu: 'SAMU / SMUR', samuUrl: '/fr/services-urgence-hopitaux/',
    civile: 'Protection civile', civileUrl: '/fr/protection-civile/',
    event: 'Événementiel sportif', eventUrl: '/fr/assistance-medicale-evenements/',
    defense: 'Défense & Militaire', defenseUrl: '/fr/defense-militaire/',
    ehs: 'Sécurité au travail', ehsUrl: '/fr/securite-travail/',
    blogUrl: '/blog/?lang=fr', resources: 'Ressources', devis: 'Obtenir un devis', devisUrl: '/#contact',
    closeMenu: 'Fermer le menu', monitorLabel: 'Moniteur EHS', monitorUrl: '/fr/monitor/',
    heroLabel: 'Ressources & Expertise',
    heroTitle: 'Tout ce que vous devez savoir sur <em>le coup de chaleur.</em>',
    heroSub: 'Protocoles médicaux, retours terrain, actualités réglementaires. Par des experts pour des professionnels.'
  },
  en: {
    home: 'Home', homeUrl: '/en/',
    distrib: 'Partners', distribUrl: '/en/partners/',
    secteurs: 'Who We Serve',
    sdis: 'Fire & Rescue', sdisUrl: '/en/fire-rescue/',
    samu: 'EMS & Emergency Depts', samuUrl: '/en/emergency-medical-services/',
    civile: 'Civil Protection', civileUrl: '/en/civil-protection/',
    event: 'Event Medical', eventUrl: '/en/event-medical-support/',
    defense: 'Defense & Military', defenseUrl: '/en/defense-military/',
    ehs: 'Occupational Safety', ehsUrl: '/en/occupational-safety/',
    blogUrl: '/blog/?lang=en', resources: 'Resources', devis: 'Get a quote', devisUrl: '/en/#contact',
    closeMenu: 'Close menu', monitorLabel: 'EHS Monitor', monitorUrl: '/en/monitor/',
    heroLabel: 'Resources & Expertise',
    heroTitle: 'Everything you need to know about <em>heat stroke.</em>',
    heroSub: 'Medical protocols, field reports, regulatory updates. By experts, for professionals.'
  },
  de: {
    home: 'Startseite', homeUrl: '/de/',
    distrib: 'Vertriebspartner', distribUrl: '/de/vertriebspartner/',
    secteurs: 'Einsatzbereiche',
    sdis: 'Feuerwehr & Rettungsdienst', sdisUrl: '/de/feuerwehr-rettungsdienst/',
    samu: 'Rettungsdienst & Notaufnahme', samuUrl: '/de/rettungsdienst-notaufnahme/',
    civile: 'Zivilschutz', civileUrl: '/de/zivilschutz/',
    event: 'Sportveranstaltungen', eventUrl: '/de/sportveranstaltungen-medizin/',
    defense: 'Verteidigung & Militär', defenseUrl: '/de/verteidigung-militaer/',
    ehs: 'Arbeitssicherheit', ehsUrl: '/de/arbeitssicherheit/',
    blogUrl: '/blog/?lang=de', resources: 'Ressourcen', devis: 'Angebot anfordern', devisUrl: '/de/#contact',
    closeMenu: 'Menü schließen', monitorLabel: 'EHS-Monitor', monitorUrl: '/de/monitor/',
    heroLabel: 'Ressourcen & Expertise',
    heroTitle: 'Alles, was Sie über <em>Hitzschlag wissen müssen.</em>',
    heroSub: 'Medizinische Protokolle, Erfahrungen aus der Praxis, regulatorische Updates. Von Experten für Fachkräfte.'
  },
  es: {
    home: 'Inicio', homeUrl: '/es/',
    distrib: 'Distribuidores', distribUrl: '/es/distribuidores/',
    secteurs: 'A quién servimos',
    sdis: 'Bomberos y Rescate', sdisUrl: '/es/bomberos-rescate/',
    samu: 'Emergencias Sanitarias', samuUrl: '/es/servicios-emergencias-sanitarias/',
    civile: 'Protección Civil', civileUrl: '/es/proteccion-civil/',
    event: 'Eventos Deportivos', eventUrl: '/es/asistencia-medica-eventos/',
    defense: 'Defensa y Militar', defenseUrl: '/es/defensa-militar/',
    ehs: 'Seguridad Laboral', ehsUrl: '/es/seguridad-laboral/',
    blogUrl: '/blog/?lang=es', resources: 'Recursos', devis: 'Solicitar presupuesto', devisUrl: '/es/#contact',
    closeMenu: 'Cerrar menú', monitorLabel: 'Monitor EHS', monitorUrl: '/es/monitor/',
    heroLabel: 'Recursos y Experiencia',
    heroTitle: 'Todo lo que necesita saber sobre el <em>golpe de calor.</em>',
    heroSub: 'Protocolos médicos, experiencia de campo, novedades normativas. Por expertos, para profesionales.'
  }
};

const _urlLang = new URLSearchParams(window.location.search).get('lang');
const _initLang = LANGS.indexOf(_urlLang) !== -1 ? _urlLang : (LANGS.indexOf(localStorage.getItem('kollder_lang')) !== -1 ? localStorage.getItem('kollder_lang') : 'fr');
setLang(_initLang);

function setLang(l) {
  if (LANGS.indexOf(l) === -1) l = 'fr';
  localStorage.setItem('kollder_lang', l);
  var t = T[l];

  LANGS.forEach(function(code) {
    var active = code === l;
    document.getElementById('btn-' + code).classList.toggle('active', active);
    document.getElementById(code + '-articles').style.display = active ? 'contents' : 'none';
    document.getElementById('cat-tabs-' + code).style.display = active ? 'contents' : 'none';
    var ov = document.getElementById('ov-' + code);
    if (ov) ov.className = active ? 'active' : '';
  });

  // Desktop nav
  document.getElementById('nav-logo-link').href = t.homeUrl;
  document.getElementById('nav-home-link').href = t.homeUrl;
  document.getElementById('nav-home-link').textContent = t.home;
  document.getElementById('nav-distrib-link').href = t.distribUrl;
  document.getElementById('nav-distrib-link').textContent = t.distrib;
  document.getElementById('nav-secteurs-link').firstChild.textContent = t.secteurs;
  document.getElementById('nav-sdis-link').href = t.sdisUrl;
  document.getElementById('nav-sdis-link').textContent = t.sdis;
  document.getElementById('nav-samu-link').href = t.samuUrl;
  document.getElementById('nav-samu-link').textContent = t.samu;
  document.getElementById('nav-civile-link').href = t.civileUrl;
  document.getElementById('nav-civile-link').textContent = t.civile;
  document.getElementById('nav-event-link').href = t.eventUrl;
  document.getElementById('nav-event-link').textContent = t.event;
  document.getElementById('nav-defense-link').href = t.defenseUrl;
  document.getElementById('nav-defense-link').textContent = t.defense;
  document.getElementById('nav-ehs-link').href = t.ehsUrl;
  document.getElementById('nav-ehs-link').textContent = t.ehs;
  document.getElementById('nav-blog-link').href = t.blogUrl;
  document.getElementById('nav-blog-label').textContent = t.resources;
  document.getElementById('nav-devis-link').href = t.devisUrl;
  document.getElementById('nav-devis-link').textContent = t.devis;

  // Mobile overlay
  document.getElementById('ov-home').href = t.homeUrl;
  document.getElementById('ov-home-label').textContent = t.home;
  document.getElementById('ov-distrib').href = t.distribUrl;
  document.getElementById('ov-distrib-label').textContent = t.distrib;
  document.getElementById('ov-secteurs-label').textContent = t.secteurs;
  document.getElementById('ov-sdis').href = t.sdisUrl;
  document.getElementById('ov-sdis-label').textContent = t.sdis;
  document.getElementById('ov-samu').href = t.samuUrl;
  document.getElementById('ov-samu-label').textContent = t.samu;
  document.getElementById('ov-civile').href = t.civileUrl;
  document.getElementById('ov-civile-label').textContent = t.civile;
  document.getElementById('ov-event').href = t.eventUrl;
  document.getElementById('ov-event-label').textContent = t.event;
  document.getElementById('ov-defense').href = t.defenseUrl;
  document.getElementById('ov-defense-label').textContent = t.defense;
  document.getElementById('ov-ehs').href = t.ehsUrl;
  document.getElementById('ov-ehs-label').textContent = t.ehs;
  document.getElementById('ov-close-btn').setAttribute('aria-label', t.closeMenu);
  document.getElementById('ov-blog').href = t.blogUrl;
  document.getElementById('ov-blog-label').textContent = t.resources;
  document.getElementById('nav-monitor-link').href = t.monitorUrl;
  document.getElementById('nav-monitor-label').textContent = t.monitorLabel;
  document.getElementById('ov-monitor').href = t.monitorUrl;
  document.getElementById('ov-monitor-label').innerHTML = t.monitorLabel + ' <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#e85c3a;margin-left:4px;vertical-align:middle;"></span>';
  document.getElementById('ov-cta').href = t.devisUrl;
  document.getElementById('ov-cta-label').textContent = t.devis;

  // Hero text
  document.getElementById('hero-label').textContent = t.heroLabel;
  document.getElementById('hero-title').innerHTML = t.heroTitle;
  document.getElementById('hero-sub').textContent = t.heroSub;
}

// DE/ES category tabs: filter the cards of the active language in place
document.querySelectorAll('button.cat-pill[data-lang]').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var lang = btn.getAttribute('data-lang');
    var filter = btn.getAttribute('data-filter');
    document.querySelectorAll('#cat-tabs-' + lang + ' .cat-pill').forEach(function(p) {
      p.classList.toggle('active', p === btn);
    });
    document.querySelectorAll('#' + lang + '-articles .article-card').forEach(function(card) {
      card.style.display = (!filter || card.getAttribute('data-cat') === filter) ? '' : 'none';
    });
  });
});

// Article count badge
fetch('/article-count.json').then(function(r){ return r.json(); }).then(function(d){
  var cnt = (d && (d.count || d.total)) || '';
  var nb = document.getElementById('nav-article-count');
  var ob = document.getElementById('ov-badge');
  if (nb && cnt) nb.textContent = cnt;
  if (ob && cnt) ob.textContent = cnt;
}).catch(function(){});

// Hamburger
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.getElementById('hamBtn');
  var overlay = document.getElementById('navOverlay');
  btn.addEventListener('click', function() {
    var isOpen = overlay.classList.toggle('open');
    btn.classList.toggle('open', isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });
  overlay.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() {
      overlay.classList.remove('open');
      btn.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
});

window.toggleNavOverlayGroup = function(btn) {
  var panel = btn.nextElementSibling;
  var isOpen = panel.classList.toggle('open');
  btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
};
window.closeNavOverlay = function() {
  var overlay = document.getElementById('navOverlay');
  var btn = document.getElementById('hamBtn');
  if (overlay) overlay.classList.remove('open');
  if (btn) btn.classList.remove('open');
  document.body.style.overflow = '';
};

</script>

<script src="/lang.js"></script>
</body>
</html>
