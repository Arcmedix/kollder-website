<body>

<nav>
  <div class="nav-brand"><a href="/"><img src="/logo-kollder.png" alt="Kollder"></a></div>
  <div class="nav-right">
    <a href="/fr/baptistere-immersion/" class="nav-back">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M13 8H3M7 4l-4 4 4 4"/></svg>
      Baptistère portable
    </a>
  </div>
</nav>

<section class="hero">
  <div class="hero-inner">
    <p class="hero-breadcrumb">
      <a href="/fr/baptistere-immersion/">Baptistère portable</a><span>›</span><span>Vie d'église</span>
    </p>
    <h1>Vie d'église</h1>
    <p class="hero-sub">Ressources pour les églises évangéliques, baptistes et pentecôtistes qui pratiquent le baptême du croyant par immersion : organiser une cérémonie sans piscine, dimensionner un bassin, choisir et entretenir un baptistère portable.</p>
    {% set articleCount = collections.blog_vie_eglise.length %}
    <p class="hero-count">{{ articleCount }} article{% if articleCount > 1 %}s{% endif %}</p>
    <a href="/fr/baptistere-immersion/#devis" class="hero-cta">
      Demander un devis
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
  </div>
</section>

<div class="blog-section">
  <div class="articles-grid">
    {% if collections.blog_vie_eglise.length %}
      {% for post in collections.blog_vie_eglise %}
        <a href="{{ post.url }}" class="article-card">
          <div class="article-body-inner">
            <p class="article-cat">{{ post.data.category }}</p>
            <h2 class="article-title">{{ post.data.title }}</h2>
            <p class="article-desc">{{ post.data.description }}</p>
            <p class="article-date">{{ post.date | dateFormat }}</p>
            <span class="article-read">
              Lire l'article
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </span>
          </div>
        </a>
      {% endfor %}
    {% else %}
      <div class="empty-state"><strong>Articles à venir.</strong><span>Revenez prochainement pour cette rubrique.</span></div>
    {% endif %}
  </div>
</div>

<footer>
  <div class="footer-inner">
    <div class="footer-brand"><img src="/logo-kollder.png" alt="Kollder"></div>
    <div class="footer-note">Emergency Cooling. Anywhere.</div>
  </div>
</footer>

